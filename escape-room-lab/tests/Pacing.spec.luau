-- The brag moment in minutes (docs/complete-game-standard.md §2: "a brag moment within about 30-45
-- minutes of normal play ... Measure the minutes with a pacing model in tests/").
-- Run: luau tests/Pacing.spec.luau 2>&1
--
-- The brag is the Roof: the exit lift of room 15 goes UP (DESIGN.md §10.3). tests/LabModel.luau walks
-- simulated players through THIS game's rooms, generated by THIS game's modules. The human times are
-- assumptions (DESIGN.md §10.1); the bounds below make a retune that drifts fail loudly:
--   * the normal player's p50 to the Roof is within 5 minutes of 37.5 (the window's centre);
--   * the normal p90 is at most 45;
--   * every band lasts at least 2 minutes for the normal player (no wing flashes by);
--   * the long-term goal (45 stars) lies beyond the brag.
local LabModel = require("./LabModel")
local Config = require("../src/shared/Config")

local passed, failed = 0, 0
local function truthy(c, msg) if c then passed += 1 else failed += 1; print("FAIL: " .. msg) end end

local pools = LabModel.pools(Config, 424242)
local q = LabModel.quantiles

local results = {}
for _, name in { "careful", "normal", "firstTimer" } do
	local r = LabModel.run(Config, pools, name, 1500, 5000 + #name)
	results[name] = r
	local roof, s45, stars = q(r.roofMin), q(r.star45Min), q(r.starsFirst)
	print(string.format("  %-10s Roof p50 %.1f min [p10 %.1f, p90 %.1f, max %.1f]; stars after the first pass p50 %d;"
		.. " 45 stars p50 %.1f min [p10 %.1f, p90 %.1f]", name, roof.p50, roof.p10, roof.p90, roof.max, stars.p50,
		s45.p50, s45.p10, s45.p90))
	local bands = {}
	for w = 1, #Config.Lab.Wings do table.insert(bands, string.format("%.1f", q(r.bandMin[w]).p50)) end
	print(string.format("             minutes per wing p50: %s; hazards met on the way p50 %.1f; the first hazard wing starts at %.1f min",
		table.concat(bands, " / "), q(r.hazards).p50, q(r.firstHazardMin).p50))
end

local normal = results.normal
local roof = q(normal.roofMin)
truthy(math.abs(roof.p50 - 37.5) <= 5, string.format("normal: the Roof at p50 %.1f min, within 5 of 37.5", roof.p50))
truthy(roof.p90 <= 45, string.format("normal: p90 %.1f min is inside the 45-minute window", roof.p90))
truthy(roof.p10 >= 30, string.format("normal: p10 %.1f min is not under 30 (the brag is earned)", roof.p10))
for w = 1, #Config.Lab.Wings do
	local b = q(normal.bandMin[w])
	truthy(b.p50 >= 2, string.format("normal: wing %d lasts %.1f min at p50 (at least 2)", w, b.p50))
end
truthy(q(normal.star45Min).p50 > roof.p50 + 10, "the long-term goal (45 stars) lies well beyond the brag")
truthy(q(results.careful.roofMin).p50 < roof.p50 and roof.p50 < q(results.firstTimer.roofMin).p50,
	"careful < normal < first-timer")
local hz = q(normal.hazards)
truthy(hz.p50 >= 8 and hz.p50 <= 20, string.format("normal: %.1f hazards on the way to the Roof (rare, not absent)", hz.p50))

print(string.format("Pacing: %d passed, %d failed", passed, failed))
if failed > 0 then error("Pacing spec failed", 0) end
